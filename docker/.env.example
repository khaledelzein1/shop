# Copier ce fichier en `.env` (même dossier) avant de lancer
# docker-compose.prod.yml. Ne jamais committer le `.env` réel.

DB_PASSWORD=change-me
# 32 caractères minimum (clé de signature JWT HMAC).
JWT_SECRET=change-me-generate-a-real-random-secret-32-bytes-min

# Compte admin de démo — désactivé par défaut en environnement "prod-like".
SEED_ADMIN_ENABLED=false
SEED_ADMIN_EMAIL=admin@shop.local
SEED_ADMIN_PASSWORD=change-me
